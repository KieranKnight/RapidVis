{
  "name": "viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "app": "npm run build && npm run build:electron && electron .",
    "package": "npm run build && npm run build:electron && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "mediabunny": "^1.62.0",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.rapidvis.viewer",
    "productName": "RapidVis",
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png"
    }
  }
}
